<!DOCTYPE RCC>
<!-- qpb's translations, embedded in qpb::core and loaded with
     qpb::loadTranslation() (doc/guide/translations.md). The .qm files are
     generated from the .ts files next to them by tools/update_translations.py. -->
<RCC version="1.0">
    <qresource prefix="/qpb/translations">
        <file>qpb_en.qm</file>
        <file>qpb_ja.qm</file>
        <file>qpb_vi.qm</file>
    </qresource>
</RCC>
