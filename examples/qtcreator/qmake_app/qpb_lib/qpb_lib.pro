# The qpb component folder (QPB_COMPONENT) as one static library, qpb::core and
# qpb::widgets together, with the settings of the component's own CMake build.
#
# Files in the folder are found by globbing, so replacing the folder with a newer
# version of qpb needs no change here. qmake globs when it runs: run qmake again
# after replacing the folder (a changed VERSION does that by itself). The settings
# that qpb applies to its own sources only (the defines below) belong to this
# project, so they do not reach the application's code. Warnings use qmake's
# warn_on level, lower than the /W4 of the CMake build.

isEmpty(QPB_COMPONENT): include(../qpb_component.pri)

TEMPLATE = lib
CONFIG += staticlib c++17 utf8_source warn_on
# One build configuration per build directory, as qpb.pri expects.
CONFIG -= debug_and_release debug_and_release_target
TARGET = qpb
QT = core widgets

# Qt's headers are external, so warnings inside them stay quiet (see qpb.pri).
msvc: QMAKE_CXXFLAGS += -external:I$$[QT_INSTALL_HEADERS] -external:W0

HEADERS += \
    $$files($$QPB_COMPONENT/include/qpb/*.h) \
    $$files($$QPB_COMPONENT/include/qpb/widgets/*.h) \
    $$files($$QPB_COMPONENT/src/core/*.h) \
    $$files($$QPB_COMPONENT/src/widgets/*.h)
SOURCES += \
    $$files($$QPB_COMPONENT/src/core/*.cpp) \
    $$files($$QPB_COMPONENT/src/widgets/*.cpp)
# The embedded translations, registered by qpb::loadTranslation().
RESOURCES += $$QPB_COMPONENT/translations/qpb_translations.qrc

# Linked statically: the export macros of qpbglobal.h expand to nothing.
DEFINES += QPB_STATIC
INCLUDEPATH += $$QPB_COMPONENT/include $$OUT_PWD/include $$QPB_COMPONENT/src

# Hygiene defines of qpb's own sources.
DEFINES += \
    QT_NO_CAST_FROM_ASCII \
    QT_NO_CAST_TO_ASCII \
    QT_NO_URL_CAST_FROM_STRING
# API deprecated before the minimum Qt version must not be used.
equals(QT_MAJOR_VERSION, 5): DEFINES += QT_DISABLE_DEPRECATED_BEFORE=0x050F00
else: DEFINES += QT_DISABLE_DEPRECATED_UP_TO=0x060500

# include/qpb/qpbversion.h from the component's VERSION, as configure_file() does
# in CMake. Written only when it changes, so running qmake again rebuilds nothing.
QPB_VERSION_STRING = $$cat($$QPB_COMPONENT/VERSION, lines)
QPB_VERSION_STRING = $$first(QPB_VERSION_STRING)
!contains(QPB_VERSION_STRING, "^[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.]+)?$"): \
    error("qpb: invalid VERSION \"$$QPB_VERSION_STRING\"")
QPB_VERSION_NUMBER = $$section(QPB_VERSION_STRING, -, 0, 0)
QPB_VERSION_MAJOR = $$section(QPB_VERSION_NUMBER, ., 0, 0)
QPB_VERSION_MINOR = $$section(QPB_VERSION_NUMBER, ., 1, 1)
QPB_VERSION_PATCH = $$section(QPB_VERSION_NUMBER, ., 2, 2)

QPB_VERSION_H = $$cat($$QPB_COMPONENT/cmake/qpbversion.h.in, blob)
# Line ends: write_file() writes the platform's own, so drop any CR here.
QPB_VERSION_H = $$replace(QPB_VERSION_H, "\\r", "")
QPB_VERSION_H = $$replace(QPB_VERSION_H, "\\s+\\z", "")
QPB_VERSION_H = $$replace(QPB_VERSION_H, "Generated by CMake", "Generated by qmake")
QPB_VERSION_H = $$replace(QPB_VERSION_H, "@QPB_VERSION_MAJOR@", $$QPB_VERSION_MAJOR)
QPB_VERSION_H = $$replace(QPB_VERSION_H, "@QPB_VERSION_MINOR@", $$QPB_VERSION_MINOR)
QPB_VERSION_H = $$replace(QPB_VERSION_H, "@QPB_VERSION_PATCH@", $$QPB_VERSION_PATCH)
QPB_VERSION_H = $$replace(QPB_VERSION_H, "@QPB_VERSION_STRING@", $$QPB_VERSION_STRING)

QPB_VERSION_FILE = $$OUT_PWD/include/qpb/qpbversion.h
exists($$QPB_VERSION_FILE) {
    QPB_VERSION_OLD = $$cat($$QPB_VERSION_FILE, blob)
    QPB_VERSION_OLD = $$replace(QPB_VERSION_OLD, "\\r", "")
    QPB_VERSION_OLD = $$replace(QPB_VERSION_OLD, "\\s+\\z", "")
}
!equals(QPB_VERSION_OLD, $$QPB_VERSION_H) {
    mkpath($$dirname(QPB_VERSION_FILE))
    write_file($$QPB_VERSION_FILE, QPB_VERSION_H)
}
HEADERS += $$QPB_VERSION_FILE

# Run qmake again when VERSION changes (e.g. after replacing the folder).
QMAKE_INTERNAL_INCLUDED_FILES += $$QPB_COMPONENT/VERSION $$QPB_COMPONENT/cmake/qpbversion.h.in
